<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.jurr.java.wapi</groupId>
		<artifactId>java-wapi-parent</artifactId>
		<version>1.0.0</version>
	</parent>

	<artifactId>java-wapi-client</artifactId>
	<name>java-wapi-client</name>
	<description>TCP transport, UDP meter receiver and discovery, and WapiClient with the function names of the C wapi library.</description>

	<dependencies>
		<dependency>
			<groupId>org.jurr.java.wapi</groupId>
			<artifactId>java-wapi-core</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.awaitility</groupId>
			<artifactId>awaitility</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Records what the client logs, for the tests -->
		<dependency>
			<groupId>com.github.valfirst</groupId>
			<artifactId>slf4j-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.jurr.java.android.classcompatibilitychecker</groupId>
			<artifactId>android-class-compatibility-checker</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Publishes the test classes, such as ScriptedWapiTransport, for the tests of java-wapi-examples -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
